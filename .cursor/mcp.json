{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ctx7sk-efcb24f9-3efa-485c-a2fe-0b23c34939fa"
      }
    },
    "mercadopago-mcp-server": {
      "url": "https://mcp.mercadopago.com/mcp"
    },
    "netlify-mcp": {
      "url": "https://netlify-mcp.netlify.app/mcp"
    },
    "netlify-mcp-local": {
      "command": "npx",
      "args": ["-y", "@netlify/mcp"],
      "env": {
        "NETLIFY_PERSONAL_ACCESS_TOKEN": "${NETLIFY_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "correios": {
      "command": "npx",
      "args": ["-y", "@codespar/mcp-correios@0.2.0-alpha.3"],
      "env": {
        "CORREIOS_USER": "",
        "CORREIOS_TOKEN": ""
      }
    }
  }
}
