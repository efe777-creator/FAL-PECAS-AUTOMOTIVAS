VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Origem canônica do sitemap (build). Default: Netlify loja.
# VITE_SITE_ORIGIN=https://fal-pecas-automotivas.netlify.app

# Identidade comercial (rodapé). CNPJ só aparece se tiver 14 dígitos.
# VITE_STORE_LEGAL_NAME=FAL Peças Automotivas Ltda
# VITE_STORE_CNPJ=00000000000000
# VITE_STORE_PHONE=11999999999
# VITE_STORE_EMAIL=contato@exemplo.com
# VITE_STORE_CITY_STATE=São Paulo — SP
# VITE_WHATSAPP_PHONE=5511999999999

# Só DEV: permitir mocks de catálogo se Supabase não estiver configurado (IMP-19 U1).
# Sem esta flag, misconfig mostra empty/erro honesto — nunca dados fictícios silenciosos.
# VITE_ALLOW_CATALOG_MOCKS=true

# Frete (F9.0): mock | correios | frenet | carrier
# Default mock — único aceito pelo place_order atual (resolve_mock_shipping_option).
# correios/frenet = sandbox local no client (não é produção; placeOrderReady=false).
# Live Correios = Edge quote-shipping + secrets CORREIOS_* (nunca VITE_).
# VITE_SHIPPING_PROVIDER=mock

# Pagamento: simulated | gateway | sandbox | mercadopago
# VITE_PAYMENT_PROVIDER=simulated
# VITE_PAYMENT_PROVIDER=mercadopago   # F9-C Pix + webhook

# Mercado Pago — SOMENTE Public Key no frontend (F9-A+)
# VITE_MP_PUBLIC_KEY=TEST-or-APP-public-key

# --- Secrets BACKEND / Supabase Edge (NUNCA VITE_ / NUNCA no git) ---
# MP_ACCESS_TOKEN=…          # Access Token TEST (Edge create-mp-payment + webhook)
# MP_WEBHOOK_SECRET=…        # secret HMAC webhook (F9-C)
# MP_ENV=test|production
# payments_enabled=true|false
#
# Correios API (Edge quote-shipping + MCP Cursor local — NUNCA no frontend):
# CORREIOS_USER=…
# CORREIOS_TOKEN=…
# MCP Cursor: .cursor/mcp.json → servidor "correios" (@codespar/mcp-correios)
# Preencher CORREIOS_* no mcp.json local OU no ambiente do SO (não commitar valores).
#
# Deploy Edge F9-B/C (auth humana):
#   npx supabase functions deploy create-mp-payment --linked
#   npx supabase functions deploy mercado-pago-webhook --linked
#   npx supabase secrets set MP_ACCESS_TOKEN=... MP_WEBHOOK_SECRET=... MP_ENV=test --linked
# Webhook URL no DevPanel:
#   https://<project-ref>.supabase.co/functions/v1/mercado-pago-webhook
#
# Deploy frete (após D-FRETE C + MARCHA HTTP):
#   npx supabase functions deploy quote-shipping --linked
#   npx supabase secrets set CORREIOS_USER=... CORREIOS_TOKEN=... --linked
