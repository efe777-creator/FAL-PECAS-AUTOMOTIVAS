VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Origem canônica do sitemap (build). Default: Netlify loja.
# VITE_SITE_ORIGIN=https://fal-pecas-automotivas.netlify.app

# Identidade comercial (rodapé). CNPJ só aparece se tiver 14 dígitos.
# VITE_STORE_LEGAL_NAME=FAL Peças Automotivas Ltda
# VITE_STORE_CNPJ=00000000000000
# VITE_STORE_PHONE=11999999999
# VITE_STORE_EMAIL=contato@exemplo.com
# VITE_STORE_CITY_STATE=São Paulo — SP
# VITE_WHATSAPP_PHONE=5511999999999

# Só DEV: permitir mocks de catálogo se Supabase não estiver configurado (IMP-19 U1).
# VITE_ALLOW_CATALOG_MOCKS=true

# --- Frete ---
# VITE_SHIPPING_PROVIDER=mock | melhorenvio | correios | frenet
# place_order: mock:* · meq:<quoteUuid>:<service> · ownq:…
# VITE_SHIPPING_PROVIDER=melhorenvio
#
# Ambiente ME na UI (deve casar com Edge MELHOR_ENVIO_API_BASE + token):
# VITE_SHIPPING_ME_ENV=sandbox      # default se omitido — homolog
# VITE_SHIPPING_ME_ENV=production   # conta nova / ops real

# --- Pagamento ---
# VITE_PAYMENT_PROVIDER=simulated | gateway | sandbox | mercadopago
# VITE_PAYMENT_PROVIDER=mercadopago
#
# Public Key SOMENTE no front (nunca Access Token):
# TEST (homolog):  VITE_MP_PUBLIC_KEY=TEST-…
# PROD (conta nova): VITE_MP_PUBLIC_KEY=APP-…

# --- Secrets BACKEND / Supabase Edge (NUNCA VITE_ / NUNCA no git) ---
#
# Mercado Pago — TEST:
#   MP_ACCESS_TOKEN=TEST-… ou APP_USR de teste
#   MP_WEBHOOK_SECRET=…
#   MP_ENV=test
#
# Mercado Pago — PROD (conta nova, momento certo):
#   MP_ACCESS_TOKEN=APP_USR…
#   MP_WEBHOOK_SECRET=…
#   MP_ENV=production
#   payments_enabled=true
#
# Melhor Envio — TEST (default API se omitir MELHOR_ENVIO_API_BASE):
#   MELHOR_ENVIO_TOKEN=…sandbox…
#   MELHOR_ENVIO_USER_AGENT=FAL Pecas Automotivas (email@dominio)
#   # MELHOR_ENVIO_API_BASE omitido → https://sandbox.melhorenvio.com.br
#
# Melhor Envio — PROD:
#   MELHOR_ENVIO_TOKEN=…produção…
#   MELHOR_ENVIO_USER_AGENT=…
#   MELHOR_ENVIO_API_BASE=https://melhorenvio.com.br
#
# Correios (opcional; live HTTP ainda 501 sem secrets):
#   CORREIOS_USER=…
#   CORREIOS_TOKEN=…
#
# Deploy Edges (quando autorizado):
#   npx supabase functions deploy create-mp-payment --use-api --yes
#   npx supabase functions deploy mercado-pago-webhook --use-api --yes
#   npx supabase functions deploy quote-shipping --use-api --yes
#   npx supabase functions deploy melhorenvio-label --use-api --yes
#   npx supabase functions deploy plate-lookup --use-api --yes
#   npx supabase secrets set MP_ACCESS_TOKEN=… MP_WEBHOOK_SECRET=… MP_ENV=… --use-api
# Webhook URL:
#   https://<project-ref>.supabase.co/functions/v1/mercado-pago-webhook
#
# --- Busca por placa (AJUSTE-028) — secrets Edge NUNCA VITE_ ---
# Consulta simples API Placas (~R$ 0,03). Token só no Supabase secrets.
#   PLATE_PROVIDER=apiplacas
#   APIPLACAS_TOKEN=…          # painel https://apiplacas.com.br/
#   # APIPLACAS_BASE_URL=https://wdapi2.com.br/v3
#   npx supabase secrets set PLATE_PROVIDER=apiplacas APIPLACAS_TOKEN=… --use-api
#   npx supabase functions deploy plate-lookup --use-api --yes
# Migration: 20261110120000_plate_lookup_cache.sql
#
# --- Busca NL / IA (P2) — secrets Edge NUNCA VITE_ ---
# Groq grátis: https://console.groq.com/keys
#   npx supabase secrets set "GROQ_API_KEY=gsk_…" --project-ref wtbpwuiayednvlhvuhbh --yes
#   # opcional: GROQ_MODEL=llama-3.3-70b-versatile
#   npx supabase functions deploy interpret-search-nl --project-ref wtbpwuiayednvlhvuhbh --yes
# Front (Netlify env + rebuild):
#   VITE_SEARCH_NL_LLM=1
# Sem key: Edge devolve intent=null → interpretSearchQuery (busca não quebra).
#
# Matriz completa: docs/planejamento/FAL_INVENTARIO_VARS_SECRETS_MP_ME_PG02_2026-11-09.md
