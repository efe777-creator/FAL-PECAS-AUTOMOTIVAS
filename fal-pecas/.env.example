VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Frete (F9.0): mock | correios | frenet | carrier
# VITE_SHIPPING_PROVIDER=frenet

# Pagamento: simulated | gateway | sandbox | mercadopago
# VITE_PAYMENT_PROVIDER=simulated
# VITE_PAYMENT_PROVIDER=mercadopago   # F9-C Pix + webhook

# Mercado Pago — SOMENTE Public Key no frontend (F9-A+)
# VITE_MP_PUBLIC_KEY=TEST-or-APP-public-key

# --- Secrets BACKEND / Supabase Edge (NUNCA VITE_ / NUNCA no git) ---
# MP_ACCESS_TOKEN=…          # Access Token TEST (Edge create-mp-payment + webhook)
# MP_WEBHOOK_SECRET=…        # secret HMAC webhook (F9-C)
# MP_ENV=test|production
# payments_enabled=true|false
#
# Deploy Edge F9-B/C (auth humana):
#   npx supabase functions deploy create-mp-payment --linked
#   npx supabase functions deploy mercado-pago-webhook --linked
#   npx supabase secrets set MP_ACCESS_TOKEN=... MP_WEBHOOK_SECRET=... MP_ENV=test --linked
# Webhook URL no DevPanel:
#   https://<project-ref>.supabase.co/functions/v1/mercado-pago-webhook
